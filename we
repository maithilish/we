#!/bin/bash
# ============================================================================
# we - work-env profile manager (main script)
#
# Intended use: source this file from ~/.bashrc or ~/.profile
#     source "$HOME/.we/we"
#
# Everything we-related lives in $WE_DIR (default: $HOME/.we):
#
#   $WE_DIR/we                  this script (sourced at login)
#   $WE_DIR/funcs.sh            profile-shell tools: walias, wcd (sourced here
#                               and inside every profile subshell)
#   $WE_DIR/we_alias            base aliases, active in every shell (optional)
#   $WE_DIR/we_func             base functions, active in every shell (optional)
#   $WE_DIR/we_<name>           profile setup script for profile <name>
#   $WE_DIR/we_<name>_alias     persisted aliases for profile <name>
#   $WE_DIR/we_<name>_func      persisted functions for profile <name>
#   $WE_DIR/state/              root snapshots, per-session files, rcfiles
#                               (auto-managed)
#
# Usage:
#   we              prompt for a profile name and create it
#   we <name>       create profile <name>
#   we ls           list profiles
#   we show <name>  show profile setup + aliases
#   we del <name>   delete a profile
#   we help         this help
#
# After creating profile "foo", typing `foo` in a terminal opens a subshell
# that inherits all exported/local variables, functions and aliases from the
# parent shell, then applies $WE_DIR/we_foo and $WE_DIR/we_foo_alias.
# Inside, use walias / wcd to add profile-specific aliases. On exit they are
# persisted automatically.
# ============================================================================

# --- setup -----------------------------------------------------------------
: "${WE_DIR:=$HOME/.we}"
export WE_DIR

WE_VERSION=2.1

mkdir -p -- "$WE_DIR/state" 2>/dev/null || {
    printf 'we: cannot create %s/state, is $HOME writable?\n' "$WE_DIR" >&2
    return 0 2>/dev/null || exit 1
}
# sweep state files older than a day (orphans from interrupted sessions)
find "$WE_DIR/state" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null || :

# profile tools are available in the base shell too (they then persist to the
# base alias file $WE_DIR/we_alias)
# shellcheck source=funcs.sh
[ -f "$WE_DIR/funcs.sh" ] && . "$WE_DIR/funcs.sh"

# base aliases (plain `alias` lines), kept for compatibility with v1
[ -f "$WE_DIR/we_alias" ] && . "$WE_DIR/we_alias"
# base functions (declare -f blocks), active in every shell
[ -f "$WE_DIR/we_func" ] && . "$WE_DIR/we_func"

# --- internal helpers --------------------------------------------------------

# names allowed for a profile
_we_valid_name() {
    local n=$1
    [[ $n =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    [[ $n != alias ]] || return 1
    [[ $n != we ]] || return 1
    return 0
}

# list profile names found in $WE_DIR (files we_<name> without the _alias / _func
# suffixes, and not the base we_alias / we_func files)
_we_profiles() {
    local f b
    for f in "$WE_DIR"/we_*; do
        [ -f "$f" ] || continue
        b=${f##*/}
        b=${b#we_}
        [[ $b == alias ]] && continue
        [[ $b == func ]] && continue
        [[ $b == *_alias ]] && continue
        [[ $b == *_func ]] && continue
        printf '%s\n' "$b"
    done
}

# define the entry command for a profile:  <name>  ->  we_enter <name>
# an alias with the same name would shadow the function (alias expansion
# happens first), so drop it
_we_register_profile() {
    local n=$1
    unalias -- "$n" 2>/dev/null
    eval "$n() { we_enter '$n'; }"
}

# register an entry command for every existing profile
_we_register_all_profiles() {
    local n
    while IFS= read -r n; do
        [ -n "$n" ] && _we_register_profile "$n"
    done < <(_we_profiles)
}

# ---------------------------------------------------------------------------
# we_enter <profile>
#   snapshot the current (parent) shell state, render a private rcfile and
#   start the profile subshell. The subshell exits back here on `exit`.
# ---------------------------------------------------------------------------
we_enter() {
    local prof=${1-}
    local rc root_sid sess_sid gen
    if [ -z "$prof" ]; then
        printf 'we: internal error: we_enter called without profile name\n' >&2
        return 1
    fi
    [ -f "$WE_DIR/we_$prof" ] || {
        printf 'we: no such profile: %s (create it with: we %s)\n' "$prof" "$prof" >&2
        return 1
    }
    [ -f "$WE_DIR/we_${prof}_alias" ] || : > "$WE_DIR/we_${prof}_alias"

    # --- SWITCH: entered from inside a profile ------------------------------
    # WE_ROOT_SID is set only in profile shells (the base shell never has it).
    # Restore the BASE (root) state, persist the current profile, and exec into
    # the new one. _we_switch does not return on success (it execs); a return
    # here means it failed (e.g. the root snapshot is missing).
    if [ -n "${WE_ROOT_SID-}" ]; then
        _we_switch "$prof"
        return 1
    fi

    # --- first entry: capture the base shell as a durable root snapshot ------
    # The snapshot is keyed to the base shell (root_sid) and is what every
    # profile in this lineage restores from, so a profile entered later from
    # inside another profile gets the BASE state, not the intermediate
    # profile's. The base shell's PID is constant for its lifetime, so
    # re-entry from the same base shell refreshes the same root files instead
    # of accumulating new ones.
    root_sid="${BASHPID}_$$"
    gen=1
    sess_sid="${root_sid}_g${gen}"

    # shell options: functions may contain extglob patterns which are a
    # syntax error to parse with extglob off, so the child restores the
    # parent's shopt state (see _we_render_rc).
    ( shopt -p ) > "$WE_DIR/state/root_${root_sid}.shopt" 2>/dev/null || : > "$WE_DIR/state/root_${root_sid}.shopt"

    # aliases: plain `alias` output is re-sourcing safe
    ( alias ) > "$WE_DIR/state/root_${root_sid}.aliases" 2>/dev/null || : > "$WE_DIR/state/root_${root_sid}.aliases"

    # functions: `declare -f` output is re-sourcing safe
    ( declare -f ) > "$WE_DIR/state/root_${root_sid}.funcs" 2>/dev/null || : > "$WE_DIR/state/root_${root_sid}.funcs"

    # non-exported, non-readonly variables (exported ones are inherited by the
    # child process automatically; readonly/special vars would error on reset)
    _we_snapshot_vars > "$WE_DIR/state/root_${root_sid}.vars" 2>/dev/null || : > "$WE_DIR/state/root_${root_sid}.vars"

    # base working directory: PWD is a special var excluded from the vars
    # snapshot; store a ready-to-source cd line (quoted so spaces survive)
    printf 'cd %q 2>/dev/null\n' "$PWD" > "$WE_DIR/state/root_${root_sid}.cwd"

    # --- render the profile rcfile ------------------------------------------
    rc="$WE_DIR/state/rc_${prof}_${sess_sid}"
    _we_render_rc "$prof" "$root_sid" "$sess_sid" "$gen" "$rc" || return 1

    # --- start the profile subshell ------------------------------------------
    # stdin is a terminal -> normal interactive child bash
    # no terminal (pipes/tests) -> force interactive so --rcfile is honoured
    # NOTE: bash requires the long option first: --rcfile must lead
    if [ -t 0 ]; then
        bash --rcfile "$rc"
    else
        bash --rcfile "$rc" -i
    fi

    # child is back. Its EXIT trap has already persisted profile aliases and
    # removed this session's files; the rm below is a fallback for the case
    # the child died without running its trap (e.g. SIGKILL). The root
    # snapshot stays for re-entry.
    rm -f -- "$rc" "$WE_DIR/state/${sess_sid}.pre" "$WE_DIR/state/${sess_sid}.cur" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------------
# _we_switch <profile>
#   Called from we_enter when WE_ROOT_SID is set (i.e. we are inside a
#   profile). Persists the current profile's session aliases, cleans up its
#   session files, renders a fresh rcfile that restores the BASE (root)
#   snapshot, and execs into the new profile. Does not return on success.
# ---------------------------------------------------------------------------
_we_switch() {
    local prof=$1
    local root_sid gen sess_sid rc f missing=0
    root_sid="$WE_ROOT_SID"

    # the root snapshot must be present to switch from
    for f in vars funcs aliases shopt cwd; do
        [ -f "$WE_DIR/state/root_${root_sid}.${f}" ] || missing=1
    done
    if [ "$missing" -eq 1 ]; then
        printf 'we: cannot switch to %s: the base snapshot is missing.\n' "$prof" >&2
        printf 'we: exit to the base shell first, then enter %s.\n' "$prof" >&2
        return 1
    fi

    # persist the current profile's session aliases before it is destroyed
    _we_profile_exit_save "${WE_PROFILE-}" "${WE_SESSION_SID-}" 2>/dev/null

    # clean up the current session's files (this process is about to exec)
    rm -f -- "$WE_DIR/state/${WE_SESSION_SID-}.pre" \
            "$WE_DIR/state/${WE_SESSION_SID-}.cur" \
            "$WE_DIR/state/rc_${WE_PROFILE-}_${WE_SESSION_SID-}" 2>/dev/null

    # new session identity: same root, next generation (exec preserves the
    # PID, so the generation is what keeps session files unique)
    gen=$(( ${WE_SESSION_GEN:-1} + 1 ))
    sess_sid="${root_sid}_g${gen}"

    rc="$WE_DIR/state/rc_${prof}_${sess_sid}"
    _we_render_rc "$prof" "$root_sid" "$sess_sid" "$gen" "$rc" || return 1

    # become the new profile (does not return)
    if [ -t 0 ]; then
        exec bash --rcfile "$rc"
    else
        exec bash --rcfile "$rc" -i
    fi
}

# ---------------------------------------------------------------------------
# _we_snapshot_vars
#   print `declare -p ...` lines for every variable that must be re-created
#   in the child shell: not exported (child already has those), not readonly,
#   not one of bash's special/managed variables.
# ---------------------------------------------------------------------------
_we_snapshot_vars() {
    local name line rest attrs
    # compgen -v lists every shell variable name (robust against names that
    # would break parameter expansion or array subscripts)
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        [[ $name == BASH_* ]] && continue      # includes BASH_FUNC_* env names
        [[ $name == _BASH_FUNC_* ]] && continue
        # bash special/managed variables: cannot (or must not) be re-assigned
        # in the child shell. (case patterns, not array subscripts: variable
        # names may contain characters that break associative subscripts.)
        case $name in
            BASH|BASHPID|COLUMNS|COMP_LINE|COMP_POINT|COMP_TYPE|DIRSTACK|EUID|FUNCNAME|HISTCMD|HOSTNAME|HOSTTYPE|IFS|LINENO|LINES|MACHTYPE|OLDPWD|OPTERR|OPTIND|OSTYPE|PIPESTATUS|PPID|PWD|RANDOM|SECONDS|SHELLOPTS|SHLVL|UID|_) continue;;
        esac
        line=$(declare -p -- "$name" 2>/dev/null) || continue
        # line: declare [-attrs] name=value  (value may span lines: keep whole)
        rest=${line#declare }
        attrs=
        if [[ $rest == -* ]]; then
            attrs=${rest%% *}        # e.g. "-x", "-ar", "--" (no attributes)
        fi
        [[ $attrs == *r* ]] && continue   # readonly: cannot and must not reset
        [[ $attrs == *x* ]] && continue   # exported: inherited by the child
        printf '%s\n' "$line"
    done < <(compgen -v)
    return 0
}

# ---------------------------------------------------------------------------
# _we_render_rc <profile> <root_sid> <sess_sid> <gen> <rcfile>
# ---------------------------------------------------------------------------
_we_render_rc() {
    local prof=$1 root_sid=$2 sess_sid=$3 gen=$4 rc=$5
    cat > "$rc" <<WE_RC_EOF
# we: rcfile for profile '$prof' (generated, do not edit)
shopt -s expand_aliases
WE_DIR='$WE_DIR'
WE_PROFILE='$prof'
export WE_PROFILE
# lineage markers: the root snapshot this shell restores from, this session's
# own id (pre/cur baseline files, exit-save), and the session generation
# (bumped on each switch so session files stay unique across exec'd sessions)
WE_ROOT_SID='$root_sid'
WE_SESSION_SID='$sess_sid'
WE_SESSION_GEN='$gen'
export WE_ROOT_SID WE_SESSION_SID WE_SESSION_GEN

# 1) inherit base shell state (root snapshot taken at first entry).
#    extglob is forced on while parsing the snapshots: functions sourced from
#    the parent may contain extglob patterns (e.g. bash-completion), which
#    are a syntax error to parse with extglob off. The parent's exact shopt
#    state is restored right afterwards, so interactive behaviour matches.
shopt -s extglob
[ -f "$WE_DIR/state/root_${root_sid}.vars" ]     && . "$WE_DIR/state/root_${root_sid}.vars"
[ -f "$WE_DIR/state/root_${root_sid}.funcs" ]    && . "$WE_DIR/state/root_${root_sid}.funcs"
[ -f "$WE_DIR/state/root_${root_sid}.aliases" ]  && . "$WE_DIR/state/root_${root_sid}.aliases"
[ -f "$WE_DIR/state/root_${root_sid}.shopt" ]    && . "$WE_DIR/state/root_${root_sid}.shopt"
# restore the base working directory (PWD is a special var, stored separately)
[ -f "$WE_DIR/state/root_${root_sid}.cwd" ]      && . "$WE_DIR/state/root_${root_sid}.cwd"

# 2) baseline of aliases before profile-specific ones: used on exit to
#    persist only what belongs to this profile
alias > "\$WE_DIR/state/${sess_sid}.pre" 2>/dev/null || : > "\$WE_DIR/state/${sess_sid}.pre"

# 3) profile setup, then profile aliases (profile wins over parent on conflict)
[ -f "\$WE_DIR/we_$prof" ]          && . "\$WE_DIR/we_$prof"
[ -f "\$WE_DIR/we_${prof}_alias" ]  && . "\$WE_DIR/we_${prof}_alias"

# 4) profile functions (persisted via wfunc; override base/root functions)
[ -f "\$WE_DIR/we_${prof}_func" ]   && . "\$WE_DIR/we_${prof}_func"

# 5) profile tools: walias, wcd, wfunc (persist into we_${prof}_alias / _func)
[ -f "\$WE_DIR/funcs.sh" ] && . "\$WE_DIR/funcs.sh"

# 6) prompt: keep the profile visible
PS1='\\[\\e[01;36m\\]we:$prof\\[\\e[0m\\] \\w \\$ '

# 7) on exit: persist profile-specific aliases, then remove this session's
#    transient files (rc + pre/cur). Each session cleans up after itself, so
#    the last profile in a switch chain is handled too.
trap '_we_profile_exit_save "$prof" "$sess_sid"; _we_session_cleanup "$prof" "$sess_sid"' EXIT
WE_RC_EOF
    return $?
}

# ---------------------------------------------------------------------------
# we <args>
# ---------------------------------------------------------------------------
we() {
    local cmd=${1-} name
    case $cmd in
        '')
            printf '\n\t\twe - work env\n\n\tname: '
            IFS= read -r name
            [ -z "$name" ] && { printf '\nwe: a profile name is required\n'; return 1; }
            _we_create "$name"
            ;;
        we|ls|list)
            _we_list
            ;;
        show)
            _we_show "${2-}"
            ;;
        del|rm|remove)
            _we_del "${2-}"
            ;;
        help|-h|--help)
            _we_help
            ;;
        -*)
            # e.g. `we -v`
            case $cmd in
                -v|--version) printf 'we %s\n' "$WE_VERSION" ;;
                *) printf 'we: unknown option: %s (try: we help)\n' "$cmd" >&2; return 1 ;;
            esac
            ;;
        *)
            # bare name -> create profile (matches v1 behaviour of `we foo`)
            _we_create "$cmd"
            ;;
    esac
}

_we_create() {
    local name=$1
    if ! _we_valid_name "$name"; then
        printf 'we: invalid profile name: %s\n' "$name" >&2
        printf 'we: names start with a letter/digit, then [A-Za-z0-9._-]\n' >&2
        return 1
    fi

    # do not clobber unrelated commands silently
    local kind; kind=$(type -t -- "$name" 2>/dev/null)
    case $kind in
        function|alias)
            printf 'we: %s already exists as %s; it will be replaced by the profile command\n' "$name" "$kind"
            ;;
        builtin|command)
            printf 'we: cannot create profile %q: it would shadow the existing %s\n' "$name" "$kind" >&2
            return 1
            ;;
    esac

    local setup="$WE_DIR/we_$name"
    local alfile="$WE_DIR/we_${name}_alias"
    local fnfile="$WE_DIR/we_${name}_func"
    local existed=0
    [ -f "$setup" ] && existed=1

    if [ "$existed" -eq 0 ]; then
        {
            printf '#!/bin/bash\n'
            printf '# we profile: %s\n' "$name"
            printf '# created: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown)"
            printf '# Profile setup: runs in the %s subshell AFTER the parent\n' "$name"
            printf '# shell state has been inherited. Edit freely.\n'
            printf '\n'
            printf 'cd %q\n' "$PWD"
            printf '\n'
        } > "$setup"
        : > "$alfile"
        : > "$fnfile"
    else
        printf 'we: profile %s already exists; keeping %s and %s\n' "$name" "$setup" "$alfile"
        [ -f "$fnfile" ] || : > "$fnfile"
    fi

    # make `name` work in this shell (also drops any alias shadowing it)
    _we_register_profile "$name"

    printf '\n'
    printf '\t - work env %s %s\n' "$name" "$([ $existed -eq 0 ] && echo created || echo re-registered)"
    printf '\t - run %s to enter the %s subshell; exit to come back\n' "$name" "$name"
    printf '\t - inside: walias <name> <command>   e.g. walias b /x/.venv/bin/python'
    [ -s "$alfile" ] && printf ' (existing aliases are listed below)'
    printf '\n'
    printf '\t - inside: wcd <name>                e.g. wcd m   (maps m -> current dir)\n'
    [ -s "$alfile" ] && { printf '\n\t - current %s aliases:\n' "$name"; grep '^alias ' "$alfile" | sed 's/^/       /'; }

    # created from inside a profile: the entry command is only registered in
    # THIS shell (the base shell never saw it), so say so explicitly
    if [ -n "${WE_ROOT_SID-}" ]; then
        printf '\t - note: created inside profile %s, so %s is only available in this shell.\n' "${WE_PROFILE-}" "$name"
        printf '\t   exit to the base shell (or re-source $WE_DIR/we) to use %s there.\n' "$name"
    fi

    printf '\n'
    return 0
}

_we_list() {
    local n found=0
    printf 'we profiles:\n'
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        found=1
        local acnt=0 fcnt=0
        [ -f "$WE_DIR/we_${n}_alias" ] && acnt=$(grep -c '^alias ' "$WE_DIR/we_${n}_alias" 2>/dev/null)
        [ -f "$WE_DIR/we_${n}_func" ] && fcnt=$(grep -cE '^[A-Za-z_][A-Za-z0-9_]* \(\)[[:space:]]*$' "$WE_DIR/we_${n}_func" 2>/dev/null)
        printf '  %-16s %s alias(es), %s func(s)\n' "$n" "${acnt:-0}" "${fcnt:-0}"
    done < <(_we_profiles)
    [ "$found" -eq 0 ] && printf '  (none)\n'
    return 0
}

_we_show() {
    local name=${1-}
    if [ -z "$name" ] || [ ! -f "$WE_DIR/we_$name" ]; then
        printf 'we: show: usage: we show <profile>\n' >&2
        return 1
    fi
    printf '== %s ==\n' "$WE_DIR/we_$name"
    cat "$WE_DIR/we_$name"
    printf '\n== %s ==\n' "$WE_DIR/we_${name}_alias"
    cat "$WE_DIR/we_${name}_alias" 2>/dev/null || printf '(none)\n'
    printf '\n== %s ==\n' "$WE_DIR/we_${name}_func"
    cat "$WE_DIR/we_${name}_func" 2>/dev/null || printf '(none)\n'
    return 0
}

_we_del() {
    local name=${1-}
    if [ -z "$name" ]; then
        printf 'we: del: usage: we del <profile>\n' >&2
        return 1
    fi
    if [ ! -f "$WE_DIR/we_$name" ] && [ ! -f "$WE_DIR/we_${name}_alias" ]; then
        printf 'we: no such profile: %s\n' "$name" >&2
        return 1
    fi
    # refuse to delete the profile we are currently inside: the session would
    # keep running and re-create the alias file on exit
    if [ -n "${WE_PROFILE-}" ] && [ "$WE_PROFILE" = "$name" ]; then
        printf 'we: cannot delete %s: you are currently inside it. Exit first.\n' "$name" >&2
        return 1
    fi
    printf 'we: delete profile %s and its aliases? [y/N] ' "$name"
    local ans
    IFS= read -r ans
    case $ans in
        y|Y|yes|YES) ;;
        *) printf 'we: aborted\n'; return 1 ;;
    esac
    rm -f -- "$WE_DIR/we_$name" "$WE_DIR/we_${name}_alias"
    rm -f -- "$WE_DIR"/state/rc_${name}_* 2>/dev/null
    # v1 compat: drop an entry alias with this name from the base alias file
    if [ -f "$WE_DIR/we_alias" ]; then
        local tmp="$WE_DIR/state/del_${name}_$$_tmp"
        grep -v -E "^alias ${name//./\\.}=" "$WE_DIR/we_alias" > "$tmp" 2>/dev/null || : > "$tmp"
        mv -- "$tmp" "$WE_DIR/we_alias"
    fi
    if type -f -- "$name" >/dev/null 2>&1 && type "$name" | grep -q 'we_enter'; then
        unset -f -- "$name"
    fi
    # also drop a v1-style entry alias with this name
    unalias -- "$name" 2>/dev/null
    printf 'we: profile %s deleted\n' "$name"
    return 0
}

_we_help() {
    cat <<'EOF'
we - work-env profile manager

usage:
  we               prompt for a name and create a profile
  we <name>        create profile <name>
  we ls            list profiles and their alias counts
  we show <name>   show profile setup file and its aliases
  we del <name>    delete a profile (with confirmation)
  we -v            show version
  we help          this help

entering a profile:
  after `we foo`, run `foo` in a terminal. A subshell starts that has
  inherited all exported/local variables, functions and aliases of the
  parent shell, plus the aliases saved in $WE_DIR/we_foo_alias.
  The file $WE_DIR/we_foo (profile setup) is also executed.

inside a profile subshell:
  walias <name> <command>   create a profile alias   e.g. walias b /x/.venv/bin/python
  wcd <name>                map <name> to the current dir  e.g. wcd m
  wfunc <name> <body>       define + persist a profile function  e.g. wfunc hi 'echo hi'
  exit                      leave the subshell; new aliases are persisted
                            to $WE_DIR/we_foo_alias automatically

  walias/wcd/wfunc also work in the base shell; there they persist to the
  base files $WE_DIR/we_alias and $WE_DIR/we_func (available in every profile).

files (all in $WE_DIR, default $HOME/.we):
  we                 this script (source it from .bashrc/.profile)
  funcs.sh           walias / wcd / wfunc implementation
  we_alias           base aliases for every shell (optional)
  we_func            base functions for every shell (optional)
  we_<name>          profile setup script
  we_<name>_alias    persisted aliases of profile <name>
  we_<name>_func     persisted functions of profile <name>
  state/             session snapshots and rcfiles (managed, do not edit)
EOF
    return 0
}

# ---------------------------------------------------------------------------
# _we_root_cleanup <root_sid>
#   Remove this base shell's root snapshot files. Installed as the base
#   shell's EXIT trap so the root_* files don't linger after the shell exits;
#   the 1-day sweep at source time is the backstop for shells that die without
#   running their trap (e.g. SIGKILL).
# ---------------------------------------------------------------------------
_we_root_cleanup() {
    local sid=${1-}
    [ -n "$sid" ] || return 0
    rm -f -- "$WE_DIR"/state/root_"${sid}".* 2>/dev/null
    return 0
}

# --- register entry commands for all existing profiles ----------------------
_we_register_all_profiles

# --- root snapshot cleanup on base-shell exit --------------------------------
# Keyed to this base shell's PID (== the root_sid we_enter computes on first
# entry). We only install the trap when the user has no EXIT trap of their
# own: chaining EXIT traps in bash is fragile, and the sweep covers the rest.
_we_base_root_sid="${BASHPID}_$$"
if [ -z "$(trap -p EXIT 2>/dev/null)" ]; then
    trap '_we_root_cleanup "'"$_we_base_root_sid"'"' EXIT
fi

# export the interface (and its closure) so child scripts/shells can use it
export -f we we_enter _we_switch _we_create _we_list _we_show _we_del _we_help \
           _we_valid_name _we_profiles _we_register_profile \
           _we_register_all_profiles _we_snapshot_vars _we_render_rc \
           _we_root_cleanup 2>/dev/null

return 0 2>/dev/null || true
